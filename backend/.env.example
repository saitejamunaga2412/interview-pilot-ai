# Server Configuration
PORT=5000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/interview_ai

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Primary AI Provider (Google Gemini Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=30000

# Remote Sandbox Code Execution (Judge0 - Required for Untrusted Student Code)
JUDGE0_URL=https://your-real-judge0-endpoint
JUDGE0_API_KEY=your_judge0_api_key

# Email Notifications (Optional - Gracefully disabled if unset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="InterviewPilot AI <no-reply@interviewpilot.ai>"
EMAIL_TEST_MODE=false
EMAIL_TEST_RECIPIENT=test@example.com

# Notification Scheduler
ENABLE_SCHEDULER=true
DAILY_REMINDER_CRON="0 8 * * *"
WEEKLY_SUMMARY_CRON="0 9 * * 0"
NOTIFICATION_TIMEZONE=UTC
